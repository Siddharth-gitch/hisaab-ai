# Local development only. Never commit a real .env file.
# Copy this file to .env and replace only the values on your own computer.

# Set this to false when you want the app to use PostgreSQL.
# Leave true to use the clickable demo without a database.
DEMO_MODE=true

# Local PostgreSQL database created in Phase 2.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/hisaab
DATABASE_SSL=false

# For the live Supabase Auth connection, use AUTH_MODE=supabase.
# For local PostgreSQL testing without sign-in, leave AUTH_MODE=demo.
AUTH_MODE=demo
SUPABASE_URL=
# Supabase now calls this the publishable key; older dashboards call it anon key.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# VITE_* values are only needed when building the signed-in frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Added in the receipt AI phase. Keep this on the server only.
# Gemini 3.6 Flash supports image and PDF receipt understanding on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

PORT=3001
